<!-- band-bash-confirmation.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registration Confirmation - <%= data.eventName %> <%= data.year %></title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap');
        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&display=swap');
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 20px;
            background-color: #f5f5f5;
            color: #333;
            line-height: 1.6;
        }
        
        .email-container {
            max-width: 650px;
            margin: 0 auto;
            background-color: #fff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
            border: 1px solid rgba(34, 0, 0, 0.05);
        }
        
        .email-header {
            background: linear-gradient(135deg, #2b0000 0%, #400000 100%);
            color: #fef08a;
            padding: 40px 30px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        
        .email-header::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%23fef08a' fill-opacity='0.05' fill-rule='evenodd'/%3E%3C/svg%3E");
            opacity: 0.8;
            z-index: 0;
        }
        
        .header-content {
            position: relative;
            z-index: 1;
        }
        
        .email-header img {
            max-width: 220px;
            height: auto;
            margin-bottom: 15px;
            filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.2));
        }
        
        .header-title {
            font-family: 'Montserrat', sans-serif;
            font-size: 28px;
            font-weight: 800;
            margin-top: 20px;
            letter-spacing: 2px;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
            position: relative;
            display: inline-block;
        }
        
        .header-title::after {
            content: "";
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 3px;
            background: linear-gradient(90deg, transparent, #fef08a, transparent);
        }
        
        .email-body {
            padding: 40px 30px;
            color: #333;
            position: relative;
        }
        
        .decorative-line {
            height: 6px;
            background: linear-gradient(90deg, #220000, #fef08a, #220000);
            margin-bottom: 30px;
        }
        
        .greeting {
            font-family: 'Playfair Display', serif;
            font-size: 22px;
            font-weight: 600;
            margin-bottom: 25px;
            color: #220000;
        }
        
        .message {
            margin-bottom: 30px;
            font-size: 16px;
            line-height: 1.7;
        }
        
        .section-title {
            font-family: 'Montserrat', sans-serif;
            font-size: 18px;
            font-weight: 700;
            color: #220000;
            margin-top: 30px;
            margin-bottom: 15px;
            padding-bottom: 8px;
            position: relative;
            display: inline-block;
        }
        
        .section-title::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, #fef08a, rgba(254, 240, 138, 0.3));
            border-radius: 3px;
        }
        
        .details-box {
            background-color: #fbfbfb;
            border-left: 4px solid #220000;
            padding: 20px;
            margin-bottom: 30px;
            border-radius: 0 8px 8px 0;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
        }
        
        .details-box p {
            margin-bottom: 12px;
        }
        
        .details-box p:last-child {
            margin-bottom: 0;
        }
        
        .details-box strong {
            color: #220000;
            font-weight: 600;
        }
        
        .team-members {
            margin-bottom: 30px;
        }
        
        .team-member {
            padding: 12px 0;
            border-bottom: 1px dashed #e0e0e0;
        }
        
        .team-member:last-child {
            border-bottom: none;
        }
        
        .contact-info {
            background: linear-gradient(145deg, #fef08a 0%, #fde047 100%);
            padding: 20px;
            border-radius: 8px;
            margin: 25px 0;
            box-shadow: 0 4px 15px rgba(254, 240, 138, 0.3);
        }
        
        .contact-info strong {
            color: #220000;
        }
        
        .note {
            background-color: #fff8e9;
            padding: 20px;
            border-radius: 8px;
            margin: 25px 0;
            border-left: 4px solid #fbbf24;
            box-shadow: 0 4px 15px rgba(251, 191, 36, 0.1);
        }
        
        .note strong {
            color: #92400e;
        }
        
        .whatsapp-link {
            display: inline-block;
            background-color: #25D366;
            color: white;
            padding: 12px 20px;
            text-decoration: none;
            border-radius: 8px;
            margin: 15px 0;
            font-weight: 500;
            box-shadow: 0 4px 10px rgba(37, 211, 102, 0.3);
            transition: all 0.3s ease;
        }
        
        .whatsapp-link:hover {
            background-color: #22c55e;
            transform: translateY(-2px);
        }
        
        .email-footer {
            background: linear-gradient(135deg, #2b0000 0%, #400000 100%);
            color: #fef08a;
            padding: 30px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        
        .email-footer::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%23fef08a' fill-opacity='0.05' fill-rule='evenodd'/%3E%3C/svg%3E");
            opacity: 0.8;
        }
        
        .footer-content {
            position: relative;
            z-index: 1;
        }
        
        .footer-heading {
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            font-size: 18px;
            letter-spacing: 1px;
            margin-bottom: 15px;
        }
        
        .social-icons {
            margin: 20px 0;
            display: flex;
            width: 100%;
            justify-content: center;
            align-items: center;
            gap: 25px;
        }
        
        .social-icon {
            display: flex;
            flex-direction: column;
            align-items: center;
            transition: all 0.3s ease;
        }
        
        .social-icon:hover {
            transform: translateY(-5px);
        }
        
        .social-icon img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            object-fit: cover;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            border: 2px solid rgba(254, 240, 138, 0.3);
            transition: all 0.3s ease;
        }
        
        .social-icon:hover img {
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
            border-color: rgba(254, 240, 138, 0.8);
        }
        
        .social-icon-label {
            margin-top: 8px;
            font-size: 12px;
            font-weight: 500;
        }
        
        .divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(254, 240, 138, 0.3), transparent);
            margin: 20px 0;
        }
        
        .footer-text {
            margin-top: 15px;
            font-size: 14px;
            opacity: 0.8;
        }
        
        .signature {
            margin-top: 35px;
            font-family: 'Playfair Display', serif;
            font-style: italic;
            font-size: 18px;
            color: #333;
        }
        
        .signature strong {
            font-family: 'Montserrat', sans-serif;
            font-style: normal;
            font-weight: 700;
            font-size: 16px;
            display: block;
            margin-top: 5px;
            color: #220000;
        }
        
        .email-link {
            color: #220000;
            text-decoration: underline;
            font-weight: 500;
        }
        
        .button {
            display: inline-block;
            background: linear-gradient(135deg, #220000 0%, #400000 100%);
            color: #fef08a;
            padding: 12px 24px;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            margin: 20px 0;
            box-shadow: 0 4px 10px rgba(34, 0, 0, 0.2);
            transition: all 0.3s ease;
        }
        
        .button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(34, 0, 0, 0.3);
        }
        
        /* Animation for gradient borders */
        @keyframes shimmer {
            0% { background-position: -100% 0; }
            100% { background-position: 100% 0; }
        }
        
        .shimmer-border {
            position: relative;
        }
        
        .shimmer-border::after {
            content: "";
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, #fef08a, #220000, #fef08a);
            background-size: 200% 100%;
            animation: shimmer 3s infinite linear;
        }
        
        @media only screen and (max-width: 600px) {
            body {
                padding: 10px;
            }
            
            .email-container {
                width: 100%;
                border-radius: 12px;
            }
            
            .email-header, .email-body, .email-footer {
                padding: 25px 20px;
            }
            
            .header-title {
                font-size: 22px;
            }
            
            .greeting {
                font-size: 20px;
            }
            
            .section-title {
                font-size: 16px;
            }
            
            .social-icons {
                gap: 15px;
            }
            
            .social-icon img {
                width: 40px;
                height: 40px;
            }
        }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="email-header">
            <div class="header-content">
                <img src="<%= data.logoUrl || 'https://i.postimg.cc/dQZZWTRd/regalia-2025-2.png' %>" alt="<%= data.eventName %> <%= data.year %> Logo">
                <div class="header-title">REGISTRATION CONFIRMATION</div>
            </div>
        </div>
        
        <div class="email-body">
            <div class="decorative-line"></div>
            
            <div class="greeting">Dear Team <%= data.teamName %>,</div>
            
            <div class="message">
                <strong>Congratulations!</strong> Your registration for Event <strong><%= data.eventName %></strong> has been successfully verified. Your enthusiasm for participation is truly appreciated, and we're looking forward to an exciting event with your energetic performance ahead! All The Best!
            </div>
            
            <div class="section-title">REGISTRATION DETAILS</div>
            <div class="details-box">
                <p><strong>Team Name:</strong> <%= data.teamName %></p>
                <p><strong>Team Leader Name:</strong> <%= data.leaderName %></p>
                <p><strong>Team Leader Phone:</strong> <%= data.leaderPhone %></p>
                <p><strong>Email:</strong> <%= data.email %></p>
            </div>
            
            <% if(data.whatsappLink) { %>
            <div>
                <strong>Join WhatsApp Group</strong><br>
                <p>Join our WhatsApp group to receive real-time updates, important announcements, and connect with other participants.</p>
                <a href="<%= data.whatsappLink %>" target="_blank" class="whatsapp-link">Join WhatsApp Group</a>
            </div>
            <% } %>
            
            <% if(data.teamMembers && data.teamMembers.length > 0) { %>
            <div class="section-title">TEAM MEMBERS</div>
            <div class="team-members details-box">
                <% data.teamMembers.forEach(function(member) { %>
                <div class="team-member">
                    <strong>Name:</strong> <%= member.name %> | <strong>Phone:</strong> <%= member.phone %>
                </div>
                <% }); %>
            </div>
            <% } %>
            
            <% if(data.coordinators && data.coordinators.length > 0) { %>
            <div class="section-title">EVENT COORDINATORS</div>
            <div class="contact-info">
                <p>For more details regarding <%= data.eventName %>, Feel free to Contact Coordinators:</p>
                <% data.coordinators.forEach(function(coordinator) { %>
                <p><strong><%= coordinator.name %>:</strong> <%= coordinator.phone %></p>
                <% }); %>
            </div>
            <% } %>
            
            <div class="note">
                <strong>Important:</strong> Join the WhatsApp group through the above attached link for further updates regarding the event schedules and instructions. For any kind of queries, feel free to ask in the group. Feel free to reach out to us at <a href="mailto:<%= data.contactEmail || 'regalia.rcciit.official@gmail.com' %>" class="email-link"><%= data.contactEmail || 'regalia.rcciit.official@gmail.com' %></a>.
            </div>
            
            <div class="message">
                Thank you once again for choosing to be a part of the <strong><%= data.eventName %></strong>. We wish you the best of luck, and we can't wait to see you showcase your talents!
            </div>
            
            <div class="signature">
                Warm regards,
                <strong><%= data.festName || 'Regalia' %> <%= data.year || '2025' %> Team</strong>
            </div>
        </div>
        
        <div class="email-footer">
            <div class="footer-content">
                <div class="footer-heading">CONNECT WITH US</div>
                
                <div class="social-icons">
                    <a target="_blank" href="https://www.instagram.com/regalia_rcciit/" class="social-icon">
                        <img src="https://i.postimg.cc/DwLzVwLQ/insta.png" alt="Instagram">
                    </a>
                    <a target="_blank" href="https://www.regalia.rcciit.in/" class="social-icon">
                        <img src="https://i.postimg.cc/qMBMQj9q/image.png" alt="Website">
                    </a>
                    <a target="_blank" href="https://rcciit.org.in/" class="social-icon">
                        <img src="https://i.postimg.cc/ZYx5r1sX/image.png" alt="College">
                    </a>
                </div>
                
                <div class="divider"></div>
                
                <div class="footer-text">
                    © <%= data.year || '2025' %> <%= data.festName || 'Regalia' %>. All rights reserved.<br>
                    <small>This is an automated email. Please do not reply.</small>
                </div>
            </div>
        </div>
    </div>
</body>
</html>